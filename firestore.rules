rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && hasUserDoc() && (
        userDoc().role == 'admin' ||
        userDoc().role == 'ADMIN'
      );
    }

    function isStoreOwner() {
      return isSignedIn() && hasUserDoc() && (
        userDoc().role == 'store_owner' ||
        userDoc().role == 'VENDOR'
      );
    }

    // --- CMS SINGLETON SECTIONS ---
    // Public users may ONLY read `<section>/published` when status == 'published' (or when not yet created).
    // Draft documents (`<section>/draft`) and explicitly unpublished documents are strictly admin-only.
    function matchCmsSection(docId) {
      return (docId == 'published' && (resource == null || resource.data.status == 'published')) || isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /homepage/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /aboutFoundation/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /impactStatistics/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /featuredRestorations/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /recognitionMedia/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /sponsors/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /marketplaceContent/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /team/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /involvementContent/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }
    match /footer/{docId} {
      allow read: if matchCmsSection(docId);
      allow write: if isAdmin();
    }

    // --- CMS MEDIA LIBRARY & REVISIONS ---
    match /media/{mediaId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /contentRevisions/{revisionId} {
      allow read, write: if isAdmin();
    }

    match /projectDrafts/{projectId} {
      allow read, write: if isAdmin();
    }

    // --- SHARED PROJECTS ---
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- OUR INITIATIVES (NORMALIZED COLLECTIONS) ---
    match /initiatives/{initiativeId} {
      allow read: if resource.data.publication_status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /initiative_images/{imageId} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /initiative_videos/{videoId} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /initiative_links/{linkId} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /initiative_team/{memberId} {
      allow read: if resource.data.is_published == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- MARKETPLACE COLLECTIONS (PRESERVED) ---
    match /stores/{storeId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isStoreOwner();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SENSITIVE RECORDS (PROTECTED) ---
    match /donations/{donationId} {
      allow create: if request.resource.data.amount is number && request.resource.data.amount >= 50;
      allow read, update, delete: if isAdmin();
    }

    match /donors/{donorId} {
      allow create, update: if isAdmin() || (request.resource.data.email is string);
      allow read, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.items is list;
      allow read, update: if isAdmin() || isStoreOwner();
      allow delete: if isAdmin();
    }

    match /volunteers/{volunteerId} {
      allow create: if request.resource.data.fullName is string && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // --- USERS & ADMIN PERMISSIONS ---
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && !(request.resource.data.role in ['admin', 'ADMIN']);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.permissions == resource.data.permissions);
      allow delete: if isAdmin();
    }
  }
}
